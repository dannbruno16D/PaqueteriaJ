@startuml
left to right direction
skinparam componentStyle rectangle

actor "Operador / ADMIN" as Op
component "paquetes.html\n(Vista)" as Vista
component "PaqueteController" as Ctrl
component "PaqueteService" as PSvc
component "UnidadRepository" as URepo
component "UsuarioRepository" as UsRepo
component "PaqueteRepository" as PRepo

Op --> Vista : 1: Selecciona paquete, unidad y transportista
Vista --> Ctrl : 2: POST /paquetes/{id}/asignar
Ctrl --> PSvc : 3: asignar(id, transportistaId, unidadId)
PSvc --> PRepo : 4: findById(id)
PSvc --> URepo : 5: findById(unidadId)
PSvc --> UsRepo : 6: findById(transportistaId)
PSvc --> PRepo : 7: save(paqueteActualizado)
Ctrl --> Vista : 8: redirect:/paquetes
@enduml